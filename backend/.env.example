# --- Database ---
# Local dev / tests (SQLite). Prod uses PostgreSQL (see docker-compose.yml).
DATABASE_URL=sqlite:///./invoiceflow.db
# DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@db:5432/invoiceflow

# --- LLM (opencode-go collection) ---
# Base URL for the OpenAI-compatible dialect (chat/completions).
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# API key (opencode-go key, also accepts shared OPENCODE_API_KEY).
OPENCODE_API_KEY=oc_sk_REPLACE_ME
# REQUIRED by opencode-go: any non-empty session string, else HTTP 400 MissingSessionID.
OPENCODE_SESSION=invoiceflow-dev

# --- Model routing (per-agent) ---
LLM_VISION_MODEL=deepseek-v4.1-flash
LLM_REASONING_MODEL=deepseek-v4-pro
LLM_CLASSIFY_MODEL=qwen3.8-flash

# --- OCR ---
TESSERACT_PATH=/usr/bin/tesseract

# --- App ---
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-prod
