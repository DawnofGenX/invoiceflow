# Copy to .env and fill in your real values. .env is gitignored.

# opencode-go API key (from https://opencode.ai/zen/go)
OPENCODE_API_KEY=oc_sk_REPLACE_ME
OPENCODE_SESSION=invoiceflow-prod
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Per-agent model routing
LLM_VISION_MODEL=deepseek-v4.1-flash
LLM_REASONING_MODEL=deepseek-v4-pro
LLM_CLASSIFY_MODEL=qwen3.8-flash

# App secret
SECRET_KEY=change-me

# LLM resilience: bounded retries on transient upstream failures only
# (429 / 5xx / timeouts). After the budget is spent the agents degrade to a
# deterministic low-confidence fallback instead of failing the request.
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_TIMEOUT_SECONDS=60

# Enables the POST /api/maintenance/reset-e2e endpoint that the smoke test
# uses to clean up its own leftover uploads. Leave empty to keep the endpoint
# disabled (it returns 404 and the smoke test skips the reset).
E2E_RESET_TOKEN=
